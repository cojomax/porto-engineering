---
import logo from '../assets/branding/logo-porto-plumbing.png';
import { services } from '../data/services';
import { contact } from '../data/contact';
import ExternalLink from './ExternalLink.astro';

const year = new Date().getFullYear();

const quickLinks = [
	{ label: 'Home', href: '/' },
	{ label: 'Services', href: '/services' },
	{ label: 'About Us', href: '/#about' },
	{ label: 'Testimonials', href: '/#testimonials' },
	{ label: 'Contact', href: '/#contact' }
];

const socials = [
	{
		label: 'Facebook',
		href: '#',
		path: 'M14 8.5h2.5V5.7c-.4-.1-1.6-.2-3-.2-3 0-4.9 1.8-4.9 5.1v2.5H5.9v3.2h2.7V21h3.3v-4.7h2.6l.4-3.2h-3V11c0-1 .3-1.6 1.6-1.6Z'
	},
	{
		label: 'Instagram',
		href: '#',
		path: 'M12 8.2a3.8 3.8 0 1 0 0 7.6 3.8 3.8 0 0 0 0-7.6Zm0 6.3a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5Zm4.8-6.4a.9.9 0 1 1-1.8 0 .9.9 0 0 1 1.8 0ZM20 8.4c-.1-1-.3-1.8-.7-2.4a4.4 4.4 0 0 0-2.5-2.5c-.6-.4-1.4-.6-2.4-.7-1-.1-1.4-.1-3.8-.1s-2.8 0-3.8.1c-1 .1-1.8.3-2.4.7a4.4 4.4 0 0 0-2.5 2.5c-.4.6-.6 1.4-.7 2.4C1.1 9.4 1.1 9.8 1.1 12.2s0 2.8.1 3.8c.1 1 .3 1.8.7 2.4a4.4 4.4 0 0 0 2.5 2.5c.6.4 1.4.6 2.4.7 1 .1 1.4.1 3.8.1s2.8 0 3.8-.1c1-.1 1.8-.3 2.4-.7a4.4 4.4 0 0 0 2.5-2.5c.4-.6.6-1.4.7-2.4.1-1 .1-1.4.1-3.8s0-2.8-.1-3.8Z'
	},
	{
		label: 'X',
		href: '#',
		path: 'm4 4 6.6 8.8L4.3 20h1.9l5.4-6.2 4.2 6.2H20l-6.9-9.3L19.1 4h-1.9l-5 5.7L8.4 4H4Z'
	}
];
---

<footer class="footer">
	<div class="container footer__grid">
		<div class="footer__brand">
			<a href="/" class="footer__logo">
				<span class="footer__logo-badge">
					<img src={logo.src} width={logo.width} height={logo.height} alt="Porto Plumbing" />
				</span>
			</a>
			<p>
				Professional plumbing and solar water heating services for homes and businesses, backed
				by the craftsmanship of Porto Engineering.
			</p>
			<div class="footer__socials">
				{
					socials.map((social) => (
						<a href={social.href} aria-label={social.label}>
							<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
								<path d={social.path} />
							</svg>
						</a>
					))
				}
			</div>
		</div>

		<div class="footer__col">
			<h3>Quick Links</h3>
			<ul>
				{
					quickLinks.map((link) => (
						<li>
							<a href={link.href}>{link.label}</a>
						</li>
					))
				}
			</ul>
		</div>

		<div class="footer__col">
			<h3>Services</h3>
			<ul>
				{
					services.map((service) => (
						<li>
							<a href={`/services#${service.slug}`}>{service.title}</a>
						</li>
					))
				}
			</ul>
		</div>

		<div class="footer__col">
			<h3>Contact Us</h3>
			<ul class="footer__contact">
				<li>
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
						<path
							d="M12 21s7-6.1 7-11.4A7 7 0 0 0 5 9.6C5 14.9 12 21 12 21Z"
							stroke="currentColor"
							stroke-width="1.5"></path>
						<circle cx="12" cy="9.5" r="2.3" stroke="currentColor" stroke-width="1.5"></circle>
					</svg>
					<ExternalLink href={contact.address.mapsUrl}>{contact.address.display}</ExternalLink>
				</li>
				<li>
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
						<path
							d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.5.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.4c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.5.1.4 0 .8-.2 1L6.6 10.8Z"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linejoin="round"></path>
					</svg>
					<a href={contact.phone.href}>{contact.phone.display}</a>
				</li>
				<li>
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
						<path
							d="M3.5 6.5h17v11h-17z"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linejoin="round"></path>
						<path
							d="m4 7 8 6 8-6"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linejoin="round"></path>
					</svg>
					<a href={`mailto:${contact.email}`}>{contact.email}</a>
				</li>
				<li>
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
						<circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.5"></circle>
						<path
							d="M12 7.5V12l3 2"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linecap="round"
							stroke-linejoin="round"></path>
					</svg>
					{contact.hours}
				</li>
			</ul>
		</div>
	</div>

	<div class="footer__bottom">
		<div class="container footer__bottom-inner">
			<p>&copy; {year} Porto Plumbing. All rights reserved.</p>
			<div class="footer__legal">
				<a href="#">Privacy Policy</a>
				<a href="#">Terms of Service</a>
				<span class="footer__group">A Porto Engineering company</span>
			</div>
		</div>
	</div>
</footer>

<style>
	.footer {
		background: var(--color-navy);
		color: rgba(255, 255, 255, 0.72);
	}

	.footer__grid {
		display: grid;
		grid-template-columns: 1.6fr 1fr 1fr 1.2fr;
		gap: 48px;
		padding-block: 72px 48px;
	}

	.footer__logo {
		display: inline-flex;
	}

	.footer__logo-badge {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 8px 10px;
		border-radius: var(--radius-sm);
		background: var(--color-white);
	}

	.footer__logo-badge img {
		height: 56px;
		width: auto;
		display: block;
	}

	.footer__brand p {
		margin-top: 16px;
		font-size: 14.5px;
		line-height: 1.7;
		max-width: 34ch;
	}

	.footer__socials {
		display: flex;
		gap: 10px;
		margin-top: 24px;
	}

	.footer__socials a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.08);
		color: var(--color-white);
		transition: background 0.2s ease;
	}

	.footer__socials a:hover {
		background: var(--color-primary);
	}

	.footer__col h3 {
		color: var(--color-white);
		font-size: 15px;
		font-weight: 700;
		margin-bottom: 20px;
	}

	.footer__col ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 12px;
		font-size: 14.5px;
	}

	.footer__col a {
		text-decoration: none;
		color: inherit;
		transition: color 0.2s ease;
	}

	.footer__col a:hover {
		color: var(--color-white);
	}

	.footer__contact li {
		display: flex;
		align-items: flex-start;
		gap: 10px;
	}

	.footer__contact svg {
		flex-shrink: 0;
		margin-top: 2px;
		color: var(--color-primary);
	}

	.footer__bottom {
		border-top: 1px solid rgba(255, 255, 255, 0.12);
	}

	.footer__bottom-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 12px;
		padding-block: 22px;
		font-size: 13.5px;
	}

	.footer__legal {
		display: flex;
		align-items: center;
		gap: 20px;
		flex-wrap: wrap;
	}

	.footer__legal a {
		text-decoration: none;
		color: inherit;
	}

	.footer__legal a:hover {
		color: var(--color-white);
	}

	.footer__group {
		color: rgba(255, 255, 255, 0.5);
	}

	@media (max-width: 900px) {
		.footer__grid {
			grid-template-columns: 1fr 1fr;
		}
	}

	@media (max-width: 560px) {
		.footer__grid {
			grid-template-columns: 1fr;
			padding-block: 56px 32px;
			gap: 36px;
		}

		.footer__bottom-inner {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
