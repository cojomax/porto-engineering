---
import ImagePlaceholder from './ImagePlaceholder.astro';
import { services } from '../data/services';
import { contact } from '../data/contact';
import ExternalLink from './ExternalLink.astro';

const stats = [
	{ value: '20+', label: 'Years in Business' },
	{ value: '5,000+', label: 'Jobs Completed' },
	{ value: '24/7', label: 'Emergency Service' },
	{ value: '100%', label: 'Satisfaction Guaranteed' }
];

const whyUs = [
	'Licensed, bonded & insured technicians',
	'Transparent, upfront pricing — no surprises',
	'24/7 emergency response, every day of the year',
	'Eco-friendly solar water heating solutions'
];

const testimonials = [
	{
		quote:
			'Lorem ipsum dolor sit amet, consectetur adipiscing elit. The team showed up on time and fixed our leak in under an hour.',
		name: 'Jordan R.',
		location: 'Residential Customer'
	},
	{
		quote:
			'Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Professional, courteous, and reasonably priced.',
		name: 'Alex M.',
		location: 'Property Manager'
	},
	{
		quote:
			'Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris. Our solar water heater install went flawlessly.',
		name: 'Sam T.',
		location: 'Business Owner'
	}
];
---

<main>
	<section class="hero">
		<div class="container hero__inner">
			<div class="hero__content">
				<span class="eyebrow">Domestic &amp; Industrial Plumbing System Upgrades</span>
				<h1>Reliable Plumbing and Solar Solutions</h1>
				<p class="hero__lead">
					Welcome to Porto Plumbing, your trusted partner in sustainable energy solutions. We specialise in
					solar geyser and pool heating installations, heat pumps, and plumbing services, delivering reliable,
					eco-friendly solutions for homes and businesses.
				</p>
				<div class="hero__actions">
					<a href="#contact" class="btn btn-primary">Get a Free Quote</a>
					<a href="tel:+15551234567" class="btn btn-outline">Call 084 514 5186</a>
				</div>
				<ul class="hero__trust">
					<li>24/7 Emergency Service</li>
					<li>Free Estimates</li>
					<li>5-Star Rated</li>
				</ul>
			</div>
			<div class="hero__media">
				<ImagePlaceholder label="Hero photo" ratio="4 / 5" rounded="lg" />
			</div>
		</div>
	</section>

	<section class="stats">
		<div class="container stats__grid">
			{
				stats.map((stat) => (
					<div class="stats__item">
						<span class="stats__value">{stat.value}</span>
						<span class="stats__label">{stat.label}</span>
					</div>
				))
			}
		</div>
	</section>

	<section id="services" class="services">
		<div class="container">
			<div class="section-heading">
				<span class="eyebrow">What We Do</span>
				<h2>Full-Service Plumbing &amp; Solar Solutions</h2>
				<p>
					We provide a wide range of professional services to meet the needs of both homes and businesses.
					From full plumbing solutions and solar water heating to pool heating and maintenance, our team
					delivers reliable, efficient, and sustainable solutions designed to make your life easier and your
					systems more energy-efficient.
				</p>
			</div>

			<div class="services__grid">
				{
					services.map((service) => (
						<div class="service-card">
							<div class="service-card__icon">
								<svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
									<path
										d={service.icon}
										stroke="currentColor"
										stroke-width="1.5"
										stroke-linecap="round"
										stroke-linejoin="round"
									/>
								</svg>
							</div>
							<h3>{service.title}</h3>
							<p>{service.description}</p>
							<a href={`/services#${service.slug}`} class="service-card__link">
								Learn more
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
									<path
										d="M5 12h14M13 6l6 6-6 6"
										stroke="currentColor"
										stroke-width="1.5"
										stroke-linecap="round"
										stroke-linejoin="round"
									/>
								</svg>
							</a>
						</div>
					))
				}
			</div>

			<div class="services__footer">
				<a href="/services" class="btn btn-outline">View All Services</a>
			</div>
		</div>
	</section>

	<section id="about" class="about">
		<div class="container about__inner">
			<div class="about__media">
				<ImagePlaceholder label="About photo" ratio="4 / 3" rounded="lg" />
			</div>
			<div class="about__content">
				<span class="eyebrow">Why Choose Us</span>
				<h2>Trusted by Homeowners &amp; Businesses Alike</h2>
				<p>
					Lorem ipsum dolor sit amet, consectetur adipiscing elit. Duis aute irure dolor in
					reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur, backed by
					the craftsmanship of our sister company, Porto Engineering.
				</p>
				<ul class="about__list">
					{
						whyUs.map((item) => (
							<li>
								<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
									<circle cx="12" cy="12" r="9.5" fill="var(--color-primary-light)" />
									<path
										d="m8 12.5 2.5 2.5 5.5-5.5"
										stroke="var(--color-primary-dark)"
										stroke-width="1.75"
										stroke-linecap="round"
										stroke-linejoin="round"
									/>
								</svg>
								{item}
							</li>
						))
					}
				</ul>
				<a href="#contact" class="btn btn-primary">Learn More About Us</a>
			</div>
		</div>
	</section>

	<section class="cta">
		<div class="container cta__inner">
			<div>
				<h2>Have a Plumbing Emergency?</h2>
				<p>Our team is on call 24/7 for urgent repairs — day or night, we're ready to help.</p>
			</div>
			<div class="cta__actions">
				<a href="tel:+15551234567" class="btn btn-light">Call Now</a>
				<a href="#contact" class="btn btn-outline btn-outline--light">Request Service</a>
			</div>
		</div>
	</section>

	<section id="testimonials" class="testimonials">
		<div class="container">
			<div class="section-heading">
				<span class="eyebrow">Testimonials</span>
				<h2>What Our Customers Say</h2>
			</div>
			<div class="testimonials__grid">
				{
					testimonials.map((testimonial) => (
						<div class="testimonial-card">
							<div class="testimonial-card__stars">
								{Array.from({ length: 5 }).map(() => (
									<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
										<path d="m12 3 2.6 5.9 6.4.6-4.8 4.3 1.4 6.3L12 17l-5.6 3.1 1.4-6.3-4.8-4.3 6.4-.6L12 3Z" />
									</svg>
								))}
							</div>
							<p class="testimonial-card__quote">&ldquo;{testimonial.quote}&rdquo;</p>
							<div class="testimonial-card__author">
								<ImagePlaceholder label="" ratio="1 / 1" rounded="full" class="testimonial-card__avatar" />
								<div>
									<span class="testimonial-card__name">{testimonial.name}</span>
									<span class="testimonial-card__location">{testimonial.location}</span>
								</div>
							</div>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section id="contact" class="contact">
		<div class="container contact__inner">
			<div class="contact__info">
				<span class="eyebrow">Get In Touch</span>
				<h2>Reach Out to Us</h2>
				<p>
					We’re here to help with all your plumbing and solar water heating needs. At Porto Plumbing, our friendly and professional team is ready
					to provide advice, quotes, and support for your home or business projects.

				</p>
				<ul class="contact__details">
					<li>
						<strong>Office</strong>
						<a href="tel:+27118289947">011 828 9947</a>
					</li>
					<li>
						<strong>Juan</strong>
						<a href={contact.phone.href}>{contact.phone.display}</a>
					</li>
					<li>
						<strong>Roberto</strong>
						<a href="tel:+27824733770">082 473 3770</a>
					</li>
					<li>
						<strong>Email</strong>
						<a href={`mailto:${contact.email}`}>{contact.email}</a>
					</li>
					<li>
						<strong>Address</strong>
						<ExternalLink href={contact.address.mapsUrl}>{contact.address.display}</ExternalLink>
					</li>
					<li>
						<strong>Hours</strong>
						<span>{contact.hours}</span>
					</li>
				</ul>
			</div>
			<form class="contact__form">
				<div class="contact__row">
					<label>
						Name
						<input type="text" name="name" placeholder="Jane Doe" />
					</label>
					<label>
						Phone
						<input type="tel" name="phone" placeholder="084 514 5186" />
					</label>
				</div>
				<label>
					Email
					<input type="email" name="email" placeholder="jane@example.com" />
				</label>
				<label>
					How can we help?
					<textarea name="message" rows="4" placeholder="Tell us about your plumbing needs..."
					></textarea>
				</label>
				<button type="submit" class="btn btn-primary contact__submit">Request a Free Quote</button>
			</form>
		</div>
	</section>
</main>

<style>
	/* Hero */
	.hero {
		padding-top: 72px;
	}

	.hero__inner {
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		gap: 56px;
		align-items: center;
	}

	.hero__content h1 {
		font-size: 44px;
		letter-spacing: -0.02em;
		margin: 14px 0 20px;
	}

	.hero__lead {
		font-size: 17px;
		color: var(--color-text-muted);
		max-width: 46ch;
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		margin-top: 28px;
	}

	.hero__trust {
		display: flex;
		flex-wrap: wrap;
		gap: 20px;
		list-style: none;
		margin: 32px 0 0;
		padding: 0;
		font-size: 14px;
		font-weight: 600;
		color: var(--color-text-muted);
	}

	.hero__trust li {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.hero__trust li::before {
		content: '';
		width: 7px;
		height: 7px;
		border-radius: 999px;
		background: var(--color-primary);
	}

	/* Stats */
	.stats {
		background: var(--color-navy);
		padding: 40px 0;
	}

	.stats__grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 24px;
		text-align: center;
	}

	.stats__item {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.stats__value {
		font-size: 30px;
		font-weight: 700;
		color: var(--color-white);
	}

	.stats__label {
		font-size: 13.5px;
		color: rgba(255, 255, 255, 0.65);
	}

	/* Section heading */
	.section-heading {
		max-width: 640px;
		margin: 0 auto 48px;
		text-align: center;
	}

	.section-heading h2 {
		font-size: 32px;
		letter-spacing: -0.01em;
		margin: 12px 0;
	}

	.section-heading p {
		color: var(--color-text-muted);
		font-size: 16px;
	}

	/* Services */
	.services {
		background: var(--color-bg-alt);
	}

	.services__grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
	}

	.services__footer {
		display: flex;
		justify-content: center;
		margin-top: 40px;
	}

	.service-card {
		background: var(--color-white);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		padding: 28px;
		transition:
			box-shadow 0.2s ease,
			transform 0.2s ease;
	}

	.service-card:hover {
		box-shadow: var(--shadow-md);
		transform: translateY(-2px);
	}

	.service-card__icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 48px;
		height: 48px;
		border-radius: var(--radius-sm);
		background: var(--color-primary-light);
		color: var(--color-primary-dark);
		margin-bottom: 18px;
	}

	.service-card h3 {
		font-size: 18px;
		margin-bottom: 10px;
	}

	.service-card p {
		color: var(--color-text-muted);
		font-size: 14.5px;
	}

	.service-card__link {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		margin-top: 18px;
		font-size: 14px;
		font-weight: 600;
		color: var(--color-primary-dark);
		text-decoration: none;
	}

	/* About */
	.about__inner {
		display: grid;
		grid-template-columns: 0.9fr 1.1fr;
		gap: 56px;
		align-items: center;
	}

	.about__content h2 {
		font-size: 32px;
		margin: 12px 0 16px;
	}

	.about__content p {
		color: var(--color-text-muted);
		max-width: 52ch;
	}

	.about__list {
		list-style: none;
		margin: 28px 0 32px;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 14px;
	}

	.about__list li {
		display: flex;
		align-items: center;
		gap: 10px;
		font-weight: 500;
		font-size: 15px;
	}

	/* CTA */
	.cta {
		background: linear-gradient(120deg, var(--color-primary-dark), var(--color-primary));
		color: var(--color-white);
	}

	.cta__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 32px;
		flex-wrap: wrap;
	}

	.cta h2 {
		font-size: 28px;
		margin-bottom: 8px;
	}

	.cta p {
		color: rgba(255, 255, 255, 0.85);
	}

	.cta__actions {
		display: flex;
		gap: 14px;
		flex-wrap: wrap;
	}

	.btn-outline--light {
		border-color: rgba(255, 255, 255, 0.5);
		color: var(--color-white);
	}

	.btn-outline--light:hover {
		border-color: var(--color-white);
		color: var(--color-white);
		background: rgba(255, 255, 255, 0.1);
	}

	/* Testimonials */
	.testimonials__grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
	}

	.testimonial-card {
		background: var(--color-white);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		padding: 28px;
	}

	.testimonial-card__stars {
		display: flex;
		gap: 4px;
		color: #f5b942;
		margin-bottom: 16px;
	}

	.testimonial-card__quote {
		color: var(--color-text-muted);
		font-size: 14.5px;
		margin-bottom: 22px;
	}

	.testimonial-card__author {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.testimonial-card__author :global(.testimonial-card__avatar) {
		width: 44px;
		height: 44px;
		flex-shrink: 0;
	}

	.testimonial-card__author :global(.testimonial-card__avatar svg) {
		width: 18px;
		height: 18px;
	}

	.testimonial-card__author :global(.testimonial-card__avatar span) {
		display: none;
	}

	.testimonial-card__name,
	.testimonial-card__location {
		display: block;
		font-size: 14px;
	}

	.testimonial-card__name {
		font-weight: 700;
	}

	.testimonial-card__location {
		color: var(--color-text-muted);
		font-size: 13px;
	}

	/* Contact */
	.contact {
		background: var(--color-bg-alt);
	}

	.contact__inner {
		display: grid;
		grid-template-columns: 0.9fr 1.1fr;
		gap: 56px;
	}

	.contact__info h2 {
		font-size: 32px;
		margin: 12px 0 16px;
	}

	.contact__info p {
		color: var(--color-text-muted);
		max-width: 46ch;
	}

	.contact__details {
		list-style: none;
		margin: 32px 0 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 18px;
	}

	.contact__details li {
		display: flex;
		flex-direction: column;
		gap: 2px;
		font-size: 15px;
	}

	.contact__details strong {
		font-size: 12.5px;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--color-text-muted);
	}

	.contact__details a {
		text-decoration: none;
		font-weight: 600;
	}

	.contact__form {
		background: var(--color-white);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		padding: 32px;
		display: flex;
		flex-direction: column;
		gap: 18px;
	}

	.contact__row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 18px;
	}

	.contact__form label {
		display: flex;
		flex-direction: column;
		gap: 8px;
		font-size: 13.5px;
		font-weight: 600;
		color: var(--color-text-muted);
	}

	.contact__form input,
	.contact__form textarea {
		font: inherit;
		font-size: 15px;
		color: var(--color-text);
		padding: 11px 14px;
		border-radius: var(--radius-sm);
		border: 1px solid var(--color-border);
		background: var(--color-bg);
		resize: vertical;
	}

	.contact__form input:focus,
	.contact__form textarea:focus {
		outline: 2px solid var(--color-primary);
		outline-offset: 1px;
	}

	.contact__submit {
		margin-top: 4px;
		width: 100%;
	}

	/* Responsive */
	@media (max-width: 960px) {
		.hero__inner,
		.about__inner,
		.contact__inner {
			grid-template-columns: 1fr;
		}

		.about__media {
			order: -1;
		}

		.services__grid,
		.testimonials__grid {
			grid-template-columns: repeat(2, 1fr);
		}

		.stats__grid {
			grid-template-columns: repeat(2, 1fr);
			row-gap: 28px;
		}
	}

	@media (max-width: 640px) {
		.hero__content h1 {
			font-size: 32px;
		}

		.services__grid,
		.testimonials__grid {
			grid-template-columns: 1fr;
		}

		.contact__row {
			grid-template-columns: 1fr;
		}

		.cta__inner {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
