---
import logo from '../assets/branding/logo-porto-plumbing.png';
import { contact } from '../data/contact';

const navLinks = [
	{ label: 'Home', href: '/' },
	{ label: 'Services', href: '/services' },
	{ label: 'Gallery', href: '/gallery' },
	{ label: 'About', href: '/#about' },
	{ label: 'Testimonials', href: '/#testimonials' },
	{ label: 'Contact', href: '/#contact' }
];
---

<header class="navbar">
	<div class="container navbar__inner">
		<a href="/" class="navbar__brand">
			<img
				src={logo.src}
				width={logo.width}
				height={logo.height}
				alt="Porto Plumbing"
				class="navbar__logo-img"
			/>
		</a>

		<nav class="navbar__nav" id="primary-nav">
			<ul>
				{
					navLinks.map((link) => (
						<li>
							<a href={link.href}>{link.label}</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div class="navbar__actions">
			<a href={contact.phone.href} class="navbar__phone">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<path
						d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.5.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.4c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.5.1.4 0 .8-.2 1L6.6 10.8Z"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linejoin="round"></path>
				</svg>
				{contact.phone.display}
			</a>
			<a href="/#contact" class="btn btn-primary">Get a Free Quote</a>
		</div>

		<button
			type="button"
			class="navbar__toggle"
			id="navbar-toggle"
			aria-expanded="false"
			aria-controls="primary-nav"
			aria-label="Toggle navigation menu"
		>
			<span></span>
			<span></span>
			<span></span>
		</button>
	</div>
</header>

<style>
	.navbar {
		position: sticky;
		top: 0;
		z-index: 50;
		background: var(--color-bg);
		border-bottom: 1px solid var(--color-border);
	}

	.navbar__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		height: 92px;
	}

	.navbar__brand {
		display: flex;
		align-items: center;
		text-decoration: none;
		color: var(--color-text);
		flex-shrink: 0;
	}

	.navbar__logo-img {
		height: 76px;
		width: auto;
	}

	.navbar__nav ul {
		display: flex;
		align-items: center;
		gap: 28px;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.navbar__nav a {
		text-decoration: none;
		color: var(--color-text-muted);
		font-weight: 500;
		font-size: 15px;
		transition: color 0.2s ease;
	}

	.navbar__nav a:hover {
		color: var(--color-primary-dark);
	}

	.navbar__actions {
		display: flex;
		align-items: center;
		gap: 20px;
		flex-shrink: 0;
	}

	.navbar__phone {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		text-decoration: none;
		font-weight: 600;
		font-size: 15px;
		color: var(--color-text);
		white-space: nowrap;
	}

	.navbar__phone svg {
		color: var(--color-primary);
	}

	.navbar__toggle {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
		width: 40px;
		height: 40px;
		border-radius: var(--radius-sm);
		border: 1px solid var(--color-border);
		background: var(--color-bg);
		cursor: pointer;
		flex-shrink: 0;
	}

	.navbar__toggle span {
		display: block;
		height: 2px;
		margin-inline: 9px;
		background: var(--color-text);
		border-radius: 2px;
		transition: transform 0.2s ease;
	}

	@media (max-width: 900px) {
		.navbar__phone {
			display: none;
		}
	}

	@media (max-width: 768px) {
		.navbar__toggle {
			display: flex;
		}

		.navbar__nav {
			position: absolute;
			top: 92px;
			left: 0;
			right: 0;
			background: var(--color-bg);
			border-bottom: 1px solid var(--color-border);
			box-shadow: var(--shadow-md);
			max-height: 0;
			overflow: hidden;
			transition: max-height 0.25s ease;
		}

		.navbar__nav.is-open {
			max-height: 320px;
		}

		.navbar__nav ul {
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			padding: 8px 24px 20px;
		}

		.navbar__nav li {
			border-top: 1px solid var(--color-border);
		}

		.navbar__nav a {
			display: block;
			padding: 14px 0;
		}

		.navbar__actions {
			display: none;
		}
	}
</style>

<script>
	const toggle = document.getElementById('navbar-toggle');
	const nav = document.getElementById('primary-nav');

	if (toggle && nav) {
		toggle.addEventListener('click', () => {
			const isOpen = nav.classList.toggle('is-open');
			toggle.setAttribute('aria-expanded', String(isOpen));
		});

		nav.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => {
				nav.classList.remove('is-open');
				toggle.setAttribute('aria-expanded', 'false');
			});
		});
	}
</script>
