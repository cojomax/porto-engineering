---
interface Props {
	label?: string;
	ratio?: string;
	rounded?: 'sm' | 'md' | 'lg' | 'full';
	class?: string;
}

const { label = 'Image', ratio = '4 / 3', rounded = 'md', class: className = '' } = Astro.props;
---

<div class:list={['img-placeholder', `is-${rounded}`, className]} style={{ aspectRatio: ratio }}>
	<svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true">
		<rect
			x="2.5"
			y="4.5"
			width="19"
			height="15"
			rx="2"
			stroke="currentColor"
			stroke-width="1.5"></rect>
		<circle cx="8" cy="10" r="1.75" stroke="currentColor" stroke-width="1.5"></circle>
		<path
			d="M4 17.5 9 12.5C9.7 11.8 10.7 11.8 11.4 12.5L14 15"
			stroke="currentColor"
			stroke-width="1.5"
			stroke-linecap="round"
			stroke-linejoin="round"></path>
		<path
			d="M13 16.5 16.6 12.8C17.3 12.1 18.3 12.1 19 12.8L21.5 15.3"
			stroke="currentColor"
			stroke-width="1.5"
			stroke-linecap="round"
			stroke-linejoin="round"></path>
	</svg>
	<span>{label}</span>
</div>

<style>
	.img-placeholder {
		width: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 8px;
		background: var(--color-bg-alt);
		border: 1px dashed var(--color-border);
		color: var(--color-text-muted);
		font-size: 13px;
		font-weight: 500;
	}

	.is-sm {
		border-radius: var(--radius-sm);
	}

	.is-md {
		border-radius: var(--radius-md);
	}

	.is-lg {
		border-radius: var(--radius-lg);
	}

	.is-full {
		border-radius: 999px;
	}
</style>
