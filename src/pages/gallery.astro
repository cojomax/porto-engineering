---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { galleryCategories } from '../data/gallery';
import { contact } from '../data/contact';
---

<Layout
	title="Gallery | Porto Plumbing"
	description="A look at our plumbing, water heating, and water saving & backup water system installations."
>
	<Navbar />

	<main>
		<section class="page-header">
			<svg
				class="page-header__waves"
				viewBox="0 0 1440 300"
				preserveAspectRatio="none"
				aria-hidden="true"
				focusable="false"
			>
				<path
					d="M0,140 C220,190 460,90 720,140 C980,190 1220,90 1440,140 L1440,300 L0,300 Z"
					fill="var(--color-primary)"
					opacity="0.08"
				/>
				<path
					d="M0,190 C260,150 500,240 720,200 C940,160 1180,250 1440,190 L1440,300 L0,300 Z"
					fill="var(--color-primary)"
					opacity="0.11"
				/>
				<path
					d="M0,230 C240,270 480,200 720,235 C960,270 1200,200 1440,230 L1440,300 L0,300 Z"
					fill="var(--color-primary-dark)"
					opacity="0.08"
				/>
			</svg>
			<div class="container page-header__inner">
				<span class="eyebrow">Our Work</span>
				<h1>Gallery</h1>
				<p>
					Explore the quality and craftsmanship of Porto Plumbing through our portfolio of completed
					projects. From expertly installed plumbing systems and solar water heating solutions to efficient
					pool heating installations, our showcase highlights the precision, professionalism, and attention to
					detail that define every job we undertake.
				</p>
			</div>
		</section>

		{
			galleryCategories.map((category) => (
				<section id={category.slug} class="gallery-category">
					<div class="container">
						<h2>{category.title}</h2>
						<div class="gallery-category__grid">
							{category.images.map((item) => (
								<div class="gallery-tile">
									<Image src={item.image} alt={item.alt} width={640} height={480} />
								</div>
							))}
						</div>
					</div>
				</section>
			))
		}

		<section class="cta">
			<div class="container cta__inner">
				<div>
					<h2>Like What You See?</h2>
					<p>Get in touch and let's talk about your project.</p>
				</div>
				<div class="cta__actions">
					<a href={contact.phone.href} class="btn btn-light">Call Now</a>
					<a href="/#contact" class="btn btn-outline btn-outline--light">Request Service</a>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</Layout>

<style>
	.page-header {
		position: relative;
		padding-top: 72px;
		padding-bottom: 56px;
		text-align: center;
		background: linear-gradient(180deg, var(--color-primary-light) 0%, var(--color-bg) 100%);
		overflow: hidden;
	}

	.page-header__waves {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		filter: blur(1.5px);
		pointer-events: none;
	}

	.page-header__inner {
		position: relative;
		z-index: 1;
		max-width: 680px;
		margin: 0 auto;
	}

	.page-header h1 {
		font-size: 40px;
		letter-spacing: -0.02em;
		margin: 14px 0 16px;
	}

	.page-header p {
		font-size: 17px;
		color: var(--color-text-muted);
	}

	.gallery-category:nth-of-type(even) {
		background: var(--color-bg-alt);
	}

	.gallery-category h2 {
		font-size: 26px;
		letter-spacing: -0.01em;
		margin-bottom: 28px;
	}

	.gallery-category__grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
	}

	.gallery-tile {
		border-radius: var(--radius-lg);
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}

	.gallery-tile img {
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		border-radius: var(--radius-lg);
	}

	.gallery-tile:hover {
		transform: translateY(-4px);
		box-shadow: var(--shadow-md);
	}

	/* CTA (matches services page banner) */
	.cta {
		background: linear-gradient(120deg, var(--color-primary-dark), var(--color-primary));
		color: var(--color-white);
	}

	.cta__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 32px;
		flex-wrap: wrap;
	}

	.cta h2 {
		font-size: 28px;
		margin-bottom: 8px;
	}

	.cta p {
		color: rgba(255, 255, 255, 0.85);
	}

	.cta__actions {
		display: flex;
		gap: 14px;
		flex-wrap: wrap;
	}

	.btn-outline--light {
		border-color: rgba(255, 255, 255, 0.5);
		color: var(--color-white);
	}

	.btn-outline--light:hover {
		border-color: var(--color-white);
		color: var(--color-white);
		background: rgba(255, 255, 255, 0.1);
	}

	@media (max-width: 960px) {
		.gallery-category__grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 640px) {
		.page-header h1 {
			font-size: 30px;
		}

		.gallery-category__grid {
			grid-template-columns: 1fr;
		}

		.cta__inner {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
